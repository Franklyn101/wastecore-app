// WasteCore database schema.
// Run `npm run db:migrate` after changing this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  CUSTOMER
  ADMIN
  COLLECTOR // a driver; linked to a Collector record
}

// What an admin account may do. OWNER (the main admin) can do everything; STAFF run the
// day-to-day (orders, collectors, tickets) but not money, accounts or settings.
enum StaffRole {
  OWNER
  STAFF
}

enum OrderType {
  INSTANT_PICKUP // one-off pickup, paid per order
  SPECIAL_PICKUP // bulky or special waste, priced by a staff quote
  PLAN_PICKUP // a pickup generated by a subscription (already paid for)
  WASTE_BAGS
}

// AWAITING_PAYMENT -> (paid online, or receipt uploaded) -> PENDING -> ASSIGNED -> COMPLETED
// INCOMPLETE and CANCELLED are terminal states set by an admin
// (a customer may cancel while AWAITING_PAYMENT).
enum OrderStatus {
  AWAITING_PAYMENT
  PENDING
  ASSIGNED
  COMPLETED
  INCOMPLETE
  CANCELLED
}

// Part of the day a pickup should happen. Null means any time.
enum TimeWindow {
  MORNING // 8am to 12pm
  AFTERNOON // 12pm to 5pm
}

enum PaymentMethod {
  PAYSTACK // verified automatically
  TRANSFER // bank transfer, checked by staff against the uploaded receipt
  CASH // paid to the collector (only for extra bags found at pickup)
}

// PENDING_PAYMENT -> ACTIVE -> (renewed, stays ACTIVE) ... -> EXPIRED
// A plan change creates a new subscription; the old one becomes REPLACED once the new one is paid.
enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  EXPIRED
  CANCELLED
  REPLACED
}

enum PaymentPurpose {
  ORDER
  ORDER_BALANCE // extra bags found at an instant pickup
  SUBSCRIPTION_START
  SUBSCRIPTION_RENEWAL
}

enum PaymentStatus {
  INITIALIZED
  SUCCESS
  FAILED
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model User {
  id                String     @id @default(cuid())
  name              String
  phone             String     @unique // E.164, e.g. +2348012345678
  email             String? // needed by Paystack for receipts; asked for at first online payment
  passwordHash      String
  // Set once the person proves they can receive SMS on this number. Needed to use the app.
  phoneVerifiedAt   DateTime?
  // Sign-in tokens issued before this are rejected, so changing a password signs out other devices.
  passwordChangedAt DateTime?
  role              Role       @default(CUSTOMER)
  staffRole         StaffRole? // admins only
  address           String?
  // Staff can suspend an account (e.g. abuse or unpaid balances); it can't sign in until restored.
  suspendedAt       DateTime?
  suspendedReason   String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  orders        Order[]
  tickets       SupportTicket[]
  subscriptions Subscription[]
  payments      Payment[]
  refunds       Refund[]
  quotes        QuoteRequest[]
  collector     Collector? // set when this login belongs to a collector
  pushTokens    PushToken[]
  notifications Notification[]
  oneTimeCodes  OneTimeCode[]
  addresses     Address[]
  areaInterests AreaInterest[]
}

// A city WasteCore serves (or will). Bookings must fall inside an active area.
model ServiceArea {
  id            String   @id @default(cuid())
  slug          String   @unique // e.g. yenagoa
  name          String // e.g. Yenagoa
  state         String // e.g. Bayelsa
  centerLat     Float
  centerLng     Float
  radiusKm      Float // bookings within this distance of the centre are in the area
  active        Boolean  @default(false) // taking bookings
  launchOrder   Int // order the areas open in (and are listed in)
  // Paid orders here go straight to the on-duty collector with the fewest jobs that day.
  autoAssign    Boolean  @default(false)
  // Most pickups (one-off and plan) per day. Null means no limit.
  dailyCapacity Int?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  addresses     Address[]
  orders        Order[]
  subscriptions Subscription[]
  collectors    Collector[]
  interests     AreaInterest[]
  quotes        QuoteRequest[]
  disposals     Disposal[]
}

// A customer's saved place, with the exact spot pinned on a map.
model Address {
  id        String    @id @default(cuid())
  userId    String
  label     String // e.g. Home, Office
  address   String // street address as the customer writes it
  landmark  String? // e.g. "Opposite Ecobank, blue gate"
  lat       Float
  lng       Float
  areaId    String
  deletedAt DateTime? // removed by the customer; kept so past orders still make sense
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  user User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area ServiceArea @relation(fields: [areaId], references: [id])

  @@index([userId])
}

// Someone outside our service areas asked to be told when we arrive.
model AreaInterest {
  id        String   @id @default(cuid())
  userId    String
  lat       Float
  lng       Float
  areaId    String? // the nearest area, if any
  createdAt DateTime @default(now())

  user User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  area ServiceArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([areaId])
}

enum CodePurpose {
  PASSWORD_RESET
  PHONE_VERIFY
}

// A 6-digit code sent by SMS (and, for password resets, email).
model OneTimeCode {
  id        String      @id @default(cuid())
  userId    String
  purpose   CodePurpose
  codeHash  String // HMAC of the code; the code itself is never stored
  expiresAt DateTime
  attempts  Int         @default(0)
  usedAt    DateTime?
  createdAt DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, createdAt])
}

// An Expo push token for one of the user's devices.
model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique // ExponentPushToken[...]
  platform  String // ios or android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Every alert sent to a user, also shown in the app's notification list.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  title     String
  body      String
  url       String? // app screen to open when tapped, e.g. /orders/abc
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Collector {
  id             String    @id @default(cuid())
  name           String
  phone          String
  area           String
  active         Boolean   @default(true)
  userId         String?   @unique // the collector's app login
  // Staff-added collectors are approved at once; self sign-ups wait for staff to approve them.
  approvedAt     DateTime?
  selfRegistered Boolean   @default(false) // created by the collector signing up in the app
  serviceAreaId  String? // the city they work in
  // Switched on in the collector app while they're working and can take jobs.
  onDuty         Boolean   @default(false)
  onDutySince    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  user          User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  serviceArea   ServiceArea?      @relation(fields: [serviceAreaId], references: [id], onDelete: SetNull)
  orders        Order[]
  subscriptions Subscription[]
  payouts       CollectorPayout[]
  disposals     Disposal[]
}

// Money paid to a collector for a batch of completed jobs.
model CollectorPayout {
  id          String   @id @default(cuid())
  collectorId String
  amount      Int // naira
  jobs        Int
  note        String? // e.g. transfer reference
  paidById    String? // the staff member who recorded it
  createdAt   DateTime @default(now())

  collector Collector @relation(fields: [collectorId], references: [id], onDelete: Cascade)
  orders    Order[]

  @@index([collectorId, createdAt])
}

model Order {
  id                 String         @id @default(cuid())
  reference          String         @unique // shown to customers, e.g. WC-4F7K2Q
  userId             String
  type               OrderType
  // Catalog key of what was bought: instant, a plan id, or small/medium/large bags.
  plan               String
  address            String
  // Where exactly, copied from the saved address when booked.
  landmark           String?
  lat                Float?
  lng                Float?
  areaId             String?
  wasteType          String?
  // Pickup date, or (for bags) the order date.
  scheduledDate      DateTime       @db.Date
  asap               Boolean        @default(false) // instant pickup requested "as soon as possible"
  timeWindow         TimeWindow?
  skippedAt          DateTime? // a plan pickup the customer chose to skip (status CANCELLED)
  // The customer's rating of a completed pickup or delivery.
  rating             Int? // 1 to 5
  ratingComment      String?
  ratedAt            DateTime?
  quantity           Int            @default(1) // bags for an instant pickup, packs for a bag order
  amount             Int // naira due for this order; 0 for plan pickups (paid by the subscription)
  status             OrderStatus    @default(AWAITING_PAYMENT)
  paymentMethod      PaymentMethod?
  receiptUrl         String?
  paidAt             DateTime?
  subscriptionId     String?
  collectorId        String?
  adminNote          String? // staff notes, also shown to the assigned collector (e.g. gate code)
  customerNote       String? // shown to the customer, e.g. why a receipt was rejected
  // Set by the collector on the job.
  onTheWayAt         DateTime?
  completedAt        DateTime?
  collectorNote      String? // e.g. why a pickup couldn't be completed; shown to the customer
  proofPhotoUrl      String? // photo taken at pickup or delivery
  // Bags actually collected. For instant pickups, bags beyond what was booked are owed as a balance.
  bagsCollected      Int?
  weightKg           Float? // weighed at pickup, when the collector has a scale
  // WasteCore bags the collector brings to a pickup; paid for when booking.
  wastecoreBags      Int            @default(0)
  // The collector came but there was no waste or nobody home; extraAmount is then the fee.
  wastedTrip         Boolean        @default(false)
  extraAmount        Int            @default(0) // naira owed for extra bags (or a wasted trip)
  extraPaidAt        DateTime?
  extraPaymentMethod PaymentMethod?
  // What the collector earns for this job, fixed when it is completed; payoutId is set once they're paid.
  collectorPay       Int?
  payoutId           String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  collector    Collector?       @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  subscription Subscription?    @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  area         ServiceArea?     @relation(fields: [areaId], references: [id], onDelete: SetNull)
  payout       CollectorPayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)
  payments     Payment[]
  tickets      SupportTicket[]
  refunds      Refund[]
  quoteRequest QuoteRequest?

  @@index([userId, createdAt])
  @@index([status, scheduledDate])
  @@index([areaId, scheduledDate])
  @@index([subscriptionId])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String
  plan               String // catalog plan id, e.g. weekly_2 or premium
  status             SubscriptionStatus @default(PENDING_PAYMENT)
  address            String
  landmark           String?
  lat                Float?
  lng                Float?
  areaId             String?
  wasteType          String
  timeWindow         TimeWindow? // preferred time for the plan's pickups
  // Billing period [currentPeriodStart, currentPeriodEnd); end is exclusive. Set when first paid.
  startDate          DateTime           @db.Date
  currentPeriodStart DateTime?          @db.Date
  currentPeriodEnd   DateTime?          @db.Date
  // Renewal charges the saved card at the end of each period when this is on.
  autoRenew          Boolean            @default(false)
  // Paystack reusable card authorization, saved from the last card payment.
  authorizationCode  String?
  cardLabel          String? // e.g. "Visa •••• 4081"
  // Renewal attempts are tracked per period so the saved card is charged at most once.
  lastRenewalAttempt DateTime?          @db.Date
  // The period end we last sent an "ending soon" reminder for, so it goes out once.
  reminderSentFor    DateTime?          @db.Date
  // Credit from the plan this one replaces, taken off the first payment.
  credit             Int                @default(0)
  replacesId         String?            @unique
  collectorId        String? // default collector for this plan's pickups
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  collector  Collector?    @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  replaces   Subscription? @relation("PlanChange", fields: [replacesId], references: [id], onDelete: SetNull)
  replacedBy Subscription? @relation("PlanChange")
  area       ServiceArea?  @relation(fields: [areaId], references: [id], onDelete: SetNull)
  orders     Order[]
  payments   Payment[]

  @@index([userId, createdAt])
  @@index([status, currentPeriodEnd])
}

model Payment {
  id             String         @id @default(cuid())
  reference      String         @unique // Paystack transaction reference
  userId         String
  purpose        PaymentPurpose
  orderId        String?
  subscriptionId String?
  amount         Int // naira
  status         PaymentStatus  @default(INITIALIZED)
  channel        String? // card, bank_transfer, ussd...
  returnUrl      String? // where to send the app after Paystack checkout
  paidAt         DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  order        Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

enum RefundMethod {
  PAYSTACK // sent back through Paystack to the customer's card or account
  MANUAL // staff sent it themselves (e.g. a bank transfer) and recorded it here
}

enum RefundStatus {
  PENDING // Paystack is processing it
  PROCESSED
  FAILED
}

// Money given back to a customer for an order.
model Refund {
  id          String       @id @default(cuid())
  orderId     String
  userId      String
  amount      Int // naira
  reason      String
  method      RefundMethod
  status      RefundStatus @default(PENDING)
  paystackId  String? // Paystack's refund id
  createdById String? // the staff member who issued it
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([orderId])
}

// Packs of waste bags in the store, per size. A size without a row isn't tracked.
model BagStock {
  size      String   @id // catalog bag size id: small, medium, large
  packs     Int
  lowAt     Int      @default(20) // staff are warned when stock falls to this
  updatedAt DateTime @updatedAt
}

// Every change to bag stock: deliveries out, restocks in, and corrections.
model StockMovement {
  id          String   @id @default(cuid())
  size        String
  change      Int // negative when packs leave the store
  reason      String
  orderId     String?
  createdById String?
  createdAt   DateTime @default(now())

  @@index([size, createdAt])
}

model SupportTicket {
  id          String       @id @default(cuid())
  reference   String       @unique // e.g. TKT-8H2M4D
  userId      String
  category    String
  message     String
  contactTime String
  orderId     String? // the order this is about, when reported from an order
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Who did what in the staff tools: order changes, refunds, suspensions, payouts, settings.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String? // the staff member (null if their account was deleted)
  actorName  String
  action     String // e.g. order.refund, customer.suspend
  targetType String // order, customer, collector, area, stock, staff...
  targetId   String?
  summary    String // a sentence for people, e.g. "Refunded ₦700 on WC-ABC123"
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

enum QuoteStatus {
  NEW // waiting for staff to price it
  QUOTED // price sent to the customer
  ACCEPTED // customer accepted; an order was created to pay for
  DECLINED // customer said no
  CANCELLED // staff can't do it, or the customer withdrew
}

// Bulky or special waste (building rubble, furniture, e-waste, event clean-up...) priced case by case.
model QuoteRequest {
  id            String      @id @default(cuid())
  reference     String      @unique // QT-XXXXXX
  userId        String
  category      String
  description   String
  photoUrl      String?
  address       String
  landmark      String?
  lat           Float
  lng           Float
  areaId        String
  preferredDate DateTime    @db.Date
  status        QuoteStatus @default(NEW)
  amount        Int? // naira, set by staff
  staffNote     String? // what the price covers, or why it can't be done
  quotedAt      DateTime?
  orderId       String?     @unique // the order created when accepted
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  area  ServiceArea @relation(fields: [areaId], references: [id])
  order Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

enum DisposalSiteKind {
  LANDFILL // government dump site
  RECYCLER // plastic, metal, paper buyers
  COMPOST
  OTHER
}

// A load taken off a truck at a dump site or recycler, for waste reporting.
model Disposal {
  id           String           @id @default(cuid())
  collectorId  String?
  areaId       String?
  site         String // e.g. "Yenagoa dump site, Igbogene"
  kind         DisposalSiteKind
  wasteType    String // main waste in the load: Mixed, Plastic, Organic...
  weightKg     Float
  ticketNo     String? // weighbridge or gate ticket
  photoUrl     String?
  note         String?
  recordedById String? // the user who logged it (collector or staff)
  disposedAt   DateTime         @default(now())
  createdAt    DateTime         @default(now())

  collector Collector?   @relation(fields: [collectorId], references: [id], onDelete: SetNull)
  area      ServiceArea? @relation(fields: [areaId], references: [id], onDelete: SetNull)

  @@index([disposedAt])
}

// App-wide settings the main admin can change, e.g. prices ("pricing").
model Setting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}
