# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/wastecore"

# Long random string used to sign login tokens (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=""

PORT=4000

# Public base URL of this API. Paystack sends customers back to it after checkout,
# and receipts stored on local disk are linked from it.
PUBLIC_URL="http://localhost:4000"

# Bank details customers pay into (shown in the app after booking).
BANK_NAME="Moniepoint"
BANK_ACCOUNT_NAME="WasteCore Limited"
BANK_ACCOUNT_NUMBER="6614999315"

# Paystack (online payments and plan renewals). Get keys at dashboard.paystack.com
# -> Settings -> API Keys & Webhooks. Use the sk_test_ key until you go live.
# Leave empty to turn online payment off (customers then pay by bank transfer).
# Also set the webhook URL in Paystack to: <PUBLIC_URL>/payments/paystack/webhook
PAYSTACK_SECRET_KEY=""
# For local testing without Paystack: run `npm run paystack:mock` and set this to http://localhost:4599
PAYSTACK_BASE_URL="https://api.paystack.co"

# Where Paystack checkout may send customers back to (comma-separated prefixes):
# the app's scheme, Expo Go during development, and the web app's address.
# In production, drop exp:// and exps:// and use your real web address.
APP_RETURN_URLS="wastecore://,exp://,exps://,http://localhost:8081/"

# Password reset codes are texted with Termii (https://termii.com) and, when the account
# has an email, emailed too. Without these, codes are only printed in the server log
# (fine for development; in production nobody would receive them).
TERMII_API_KEY=""
# A sender ID approved by Termii, e.g. "WasteCore" (needed for the "dnd" channel).
TERMII_SENDER_ID=""
# Your account's base URL from the Termii dashboard.
TERMII_BASE_URL="https://api.ng.termii.com"
# "dnd" reaches numbers on Do-Not-Disturb (most Nigerian lines); "generic" doesn't.
TERMII_CHANNEL="dnd"

# Any SMTP email provider (Zoho, Brevo, Mailgun, Google Workspace...).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="WasteCore <no-reply@yourdomain.com>"

# Push notifications go through Expo's push service. Only needed if you turn on
# "Enhanced security for push notifications" in your Expo account settings.
EXPO_ACCESS_TOKEN=""

# The API renews and expires plans hourly. Set to "false" if you run `npm run jobs` from cron instead.
RUN_JOBS="true"

# Optional: store receipt images on Cloudinary. If unset, receipts are saved
# to ./uploads on this server's disk (fine for development, not for production).
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Used by `npm run db:create-admin` to create the first admin account.
ADMIN_NAME="WasteCore Admin"
ADMIN_PHONE=""
ADMIN_PASSWORD=""
