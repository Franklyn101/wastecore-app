{
  "expo": {
    "name": "WasteCore",
    "slug": "wastecore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wastecore.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E8F5EC",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.wastecore.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "WasteCore needs access to your photos so you can upload payment receipts.",
          "cameraPermission": "WasteCore needs camera access so you can photograph payment receipts."
        }
      ],
      "expo-web-browser"
    ],
    "scheme": "wastecore"
  }
}
